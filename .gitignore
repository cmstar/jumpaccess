/bin/
/dist/
# 统一忽略任意层级以点开头的文件和目录。
.*
*.exe
*.test
coverage.out

/cmd/jumpaccess/build/bin/
/cmd/jumpaccess/frontend/dist/*
!/cmd/jumpaccess/frontend/dist/gitkeep
/cmd/jumpaccess/frontend/node_modules/
/cmd/jumpaccess/frontend/wailsjs/
/cmd/jumpaccess/frontend/package.json.md5

# GitHub 工作流与协作模板必须进入仓库。
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/pull_request_template.md
